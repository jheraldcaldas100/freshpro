# Copia este archivo como .env para desarrollo local. En producción (Render) estas variables
# se cargan en el panel del servicio; prod NUNCA lee .env.

# Opcional: link de la Google Sheet publicada como CSV (ver docs/DESARROLLO.md, "Contenido").
# HOJA_CSV_URL=https://docs.google.com/spreadsheets/d/e/.../pub?gid=0&single=true&output=csv

# Opcional en local: sin DATABASE_URL se usa SQLite (db.sqlite3).
# DATABASE_URL=postgres://usuario:clave@localhost:5432/oppu

# --- Solo producción ---
# DJANGO_SETTINGS_MODULE=config.settings.prod
# SECRET_KEY=            # genera una con: uv run python -c "import secrets; print(secrets.token_urlsafe(50))"
# DATABASE_URL=          # la cadena de conexión de Neon (con ?sslmode=require)
# ALLOWED_HOSTS=         # dominios extra separados por coma; Render agrega el suyo solo
# CSRF_TRUSTED_ORIGINS=  # https://dominio-extra, separados por coma
# ADMIN_URL=             # ruta no obvia, p. ej. gestion-7f3k/  ("admin/" no se acepta)
